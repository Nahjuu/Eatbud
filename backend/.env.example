PORT=3000
# Origen(es) permitidos por CORS. Acepta varias URLs separadas por comas.
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Modelo con visión de Groq, usado sólo cuando la comida se envía con una foto.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Respaldo opcional: si Groq falla, se usa DeepSeek (API compatible con OpenAI).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
